# SS International — environment variables
#
# As of this handover, the codebase does not read process.env anywhere,
# so nothing here is required to run `npm run dev` / `npm run build` locally.
# This file documents variables a likely next step would introduce.
# Copy to `.env.local` and fill in real values — never commit that file.

# --- Email (the "resend" package is already an installed dependency, unused so far) ---
# If the /contact form or another feature is wired up to send email via Resend:
RESEND_API_KEY=

# --- Google Apps Script backend used by /customer-registration ---
# Currently hardcoded as constants (APPS_SCRIPT_URL, DRIVE_FOLDER_ID) directly in
# src/app/customer-registration/page.tsx rather than read from env. Listed here as
# candidates to migrate into env vars if that endpoint ever needs to change per
# environment (e.g. a staging vs. production Apps Script deployment).
NEXT_PUBLIC_APPS_SCRIPT_URL=
NEXT_PUBLIC_DRIVE_FOLDER_ID=

# --- Vercel deployment (for reference only; Vercel sets these automatically on its platform) ---
# VERCEL_PROJECT_ID=
# VERCEL_ORG_ID=
